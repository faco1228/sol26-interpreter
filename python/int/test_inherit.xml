<?xml version="1.0" encoding="UTF-8"?>
<program language="SOL26">
  <class name="Animal" parent="Object">
    <method selector="speak">
      <block arity="0">
        <assign order="1">
          <var name="_"/>
          <expr>
            <send selector="print">
              <expr>
                <literal class="String" value="Some sound"/>
              </expr>
            </send>
          </expr>
        </assign>
      </block>
    </method>
  </class>
  <class name="Dog" parent="Animal">
    <method selector="speak">
      <block arity="0">
        <assign order="1">
          <var name="_"/>
          <expr>
            <send selector="print">
              <expr>
                <literal class="String" value="Woof"/>
              </expr>
            </send>
          </expr>
        </assign>
      </block>
    </method>
    <method selector="run">
      <block arity="0">
        <assign order="1">
          <var name="_"/>
          <expr>
            <send selector="speak">
              <expr>
                <var name="self"/>
              </expr>
            </send>
          </expr>
        </assign>
        <assign order="2">
          <var name="_"/>
          <expr>
            <send selector="speak">
              <expr>
                <var name="super"/>
              </expr>
            </send>
          </expr>
        </assign>
      </block>
    </method>
  </class>
  <class name="Main" parent="Object">
    <method selector="run">
      <block arity="0">
        <assign order="1">
          <var name="d"/>
          <expr>
            <send selector="new">
              <expr>
                <literal class="class" value="Dog"/>
              </expr>
            </send>
          </expr>
        </assign>
        <assign order="2">
          <var name="_"/>
          <expr>
            <send selector="run">
              <expr>
                <var name="d"/>
              </expr>
            </send>
          </expr>
        </assign>
      </block>
    </method>
  </class>
</program>
