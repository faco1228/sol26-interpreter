<?xml version="1.0" encoding="UTF-8"?>
<program language="SOL26">
  <class name="Main" parent="Object">
    <method selector="run">
      <block arity="0">
        <assign order="1">
          <var name="_"/>
          <expr>
            <send selector="timesRepeat:">
              <expr>
                <literal class="Integer" value="5"/>
              </expr>
              <arg order="1">
                <expr>
                  <block arity="1">
                    <parameter order="1" name="i"/>
                    <assign order="1">
                      <var name="s"/>
                      <expr>
                        <send selector="asString">
                          <expr>
                            <var name="i"/>
                          </expr>
                        </send>
                      </expr>
                    </assign>
                    <assign order="2">
                      <var name="_"/>
                      <expr>
                        <send selector="print">
                          <expr>
                            <var name="s"/>
                          </expr>
                        </send>
                      </expr>
                    </assign>
                  </block>
                </expr>
              </arg>
            </send>
          </expr>
        </assign>
      </block>
    </method>
  </class>
</program>
